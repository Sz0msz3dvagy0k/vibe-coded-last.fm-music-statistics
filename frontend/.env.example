# Base path for the application (default: /)
# Set this to deploy the app under a subdirectory like /dashboard/
# Examples:
#   VITE_BASE_PATH=/
#   VITE_BASE_PATH=/dashboard/
#   VITE_BASE_PATH=/music/
# Note: Must start and end with /
VITE_BASE_PATH=/

# Backend API server URL (default: http://localhost:3001/api)
# Set this to point to your backend server
# Examples:
#   VITE_API_URL=http://localhost:3001/api
#   VITE_API_URL=https://api.example.com/api
#   VITE_API_URL=https://music.szomszed.me/api
VITE_API_URL=http://localhost:3001/api
